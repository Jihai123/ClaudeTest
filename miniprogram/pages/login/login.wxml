<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- 顶部装饰 -->
  <view class="header">
    <view class="logo">
      <text class="logo-icon">🏠</text>
    </view>
    <text class="title">宜居城市</text>
    <text class="subtitle">发现你的理想居住地</text>
  </view>

  <!-- 登录方式切换 -->
  <view class="tab-switch">
    <view
      class="tab-item {{loginType === 'wechat' ? 'active' : ''}}"
      bindtap="switchLoginType"
      data-type="wechat"
    >
      <text>微信登录</text>
    </view>
    <view
      class="tab-item {{loginType === 'password' ? 'active' : ''}}"
      bindtap="switchLoginType"
      data-type="password"
    >
      <text>账号登录</text>
    </view>
  </view>

  <!-- 登录区域 -->
  <view class="login-area">
    <!-- 微信登录 -->
    <view class="wechat-login" wx:if="{{loginType === 'wechat'}}">
      <!-- 头像和昵称输入（可选） -->
      <view class="profile-setup">
        <text class="setup-title">设置个人信息（可选）</text>

        <!-- 头像选择 -->
        <view class="avatar-picker">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image wx:if="{{wxAvatarUrl}}" class="avatar-img" src="{{wxAvatarUrl}}" mode="aspectFill"/>
            <view wx:else class="avatar-placeholder">
              <text>📷</text>
              <text class="avatar-hint">点击选头像</text>
            </view>
          </button>
        </view>

        <!-- 昵称输入 -->
        <view class="nickname-input">
          <input
            type="nickname"
            class="input"
            placeholder="点击输入昵称"
            value="{{wxNickname}}"
            bindinput="onNicknameInput"
          />
        </view>
      </view>

      <button
        class="wechat-login-btn {{loading ? 'loading' : ''}}"
        bindtap="onWechatLogin"
        disabled="{{loading}}"
      >
        <text class="btn-icon" wx:if="{{!loading}}">💚</text>
        <text wx:if="{{loading}}">登录中...</text>
        <text wx:else>微信一键登录</text>
      </button>

      <view class="wechat-tips">
        <text>无需填写信息，可直接点击登录</text>
      </view>
    </view>

    <!-- 账号密码登录 -->
    <view class="password-login" wx:if="{{loginType === 'password'}}">
      <view class="form-group">
        <view class="input-wrapper">
          <text class="input-icon">👤</text>
          <input
            class="input"
            placeholder="用户名或邮箱"
            value="{{username}}"
            bindinput="onUsernameInput"
          />
        </view>
      </view>

      <view class="form-group">
        <view class="input-wrapper">
          <text class="input-icon">🔒</text>
          <input
            class="input"
            placeholder="密码"
            password="{{!showPassword}}"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
          <text class="toggle-password" bindtap="togglePassword">
            {{showPassword ? '🙈' : '👁️'}}
          </text>
        </view>
      </view>

      <button
        class="password-login-btn {{loading ? 'loading' : ''}}"
        bindtap="onPasswordLogin"
        disabled="{{loading}}"
      >
        <text wx:if="{{loading}}">登录中...</text>
        <text wx:else>登 录</text>
      </button>

      <view class="form-tips">
        <text class="link">忘记密码？</text>
      </view>
    </view>

    <!-- 隐私提示 -->
    <view class="privacy-tips">
      <text>登录即表示同意</text>
      <text class="link">用户协议</text>
      <text>和</text>
      <text class="link">隐私政策</text>
    </view>
  </view>

  <!-- 跳过登录 -->
  <view class="skip-area" bindtap="onBack">
    <text>暂不登录</text>
  </view>
</view>
