/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4f8 0%, #ffffff 100%);
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 60rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  background: #ffffff;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 70rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
}

/* Tab切换 */
.tab-switch {
  display: flex;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  background: #ffffff;
  color: #333;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 登录区域 */
.login-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.login-tips {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.login-tips > text {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.tip-item text:last-child {
  font-size: 26rpx;
  color: #666;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn.loading {
  opacity: 0.7;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 账号密码登录 */
.password-login {
  width: 100%;
}

.form-group {
  margin-bottom: 24rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
}

.toggle-password {
  font-size: 36rpx;
  padding: 10rpx;
}

.password-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3);
}

.password-login-btn::after {
  border: none;
}

.password-login-btn.loading {
  opacity: 0.7;
}

.form-tips {
  margin-top: 24rpx;
  text-align: right;
}

.form-tips .link {
  font-size: 26rpx;
  color: #2563eb;
}

/* 隐私提示 */
.privacy-tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.privacy-tips .link {
  color: #07c160;
}

/* 跳过登录 */
.skip-area {
  padding: 32rpx;
  text-align: center;
}

.skip-area text {
  font-size: 28rpx;
  color: #999;
}
