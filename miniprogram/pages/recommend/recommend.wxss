/* pages/recommend/recommend.wxss */

/* 容器 */
.container {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #87A878 0%, #6B8E65 100%);
  padding: 60rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 16rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* 问卷 */
.questionnaire {
  padding: 0 32rpx;
}

/* 问题卡片 */
.question-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.question-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.question-number {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #87A878 0%, #6B8E65 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.question-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

/* 选项 */
.options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F7F8FA;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 32rpx 20rpx;
  transition: all 0.3s;
}

.option-item:active {
  transform: scale(0.95);
}

.option-item.selected {
  background: rgba(135, 168, 120, 0.1);
  border-color: #87A878;
  box-shadow: 0 4rpx 12rpx rgba(135, 168, 120, 0.2);
}

.option-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.option-text {
  font-size: 26rpx;
  color: #4B5563;
  text-align: center;
  line-height: 1.4;
}

.option-item.selected .option-text {
  color: #87A878;
  font-weight: 600;
}

/* 操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.recommend-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #87A878 0%, #6B8E65 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(135, 168, 120, 0.3);
}

.recommend-btn::after {
  border: none;
}

.recommend-btn.disabled {
  background: #E5E7EB;
  color: #9CA3AF;
  box-shadow: none;
}

.progress-hint {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #87A878;
}
