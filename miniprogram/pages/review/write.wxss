/* 评价发布页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
  color: white;
}

.city-name {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.form {
  padding: 40rpx;
}

.form-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 8rpx;
}

/* 评分星星 */
.rating-stars {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.star {
  font-size: 60rpx;
  color: #e8e8e8;
  transition: color 0.2s;
}

.star.active {
  color: #ffb800;
}

.rating-text {
  margin-left: 20rpx;
  font-size: 32rpx;
  color: #666;
  font-weight: bold;
}

/* 维度评分 */
.dimension-ratings {
  margin-top: 20rpx;
}

.dimension-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.dimension-name {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.dimension-slider {
  flex: 1;
  margin: 0 20rpx;
}

.dimension-value {
  width: 80rpx;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 选择器 */
.picker {
  padding: 20rpx 30rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
}

/* 文本域 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 图片上传 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item,
.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 50rpx;
  height: 50rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  border-bottom-left-radius: 12rpx;
}

.image-add {
  border: 2rpx dashed #d9d9d9;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 匿名选项 */
.anonymous-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.anonymous-text {
  font-size: 30rpx;
  color: #333;
}

/* 提交按钮 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  opacity: 0.8;
}
