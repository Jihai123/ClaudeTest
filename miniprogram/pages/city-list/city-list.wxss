/* pages/city-list/city-list.wxss */

/* 容器 */
.container {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面标题 */
.page-header {
  background: #ffffff;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 16rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 12rpx;
}

.result-count {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 搜索栏 */
.search-bar {
  background: #ffffff;
  padding: 0 32rpx 32rpx;
  margin-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E5E7EB;
}

.search-icon {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
}

.search-input::placeholder {
  color: #9CA3AF;
}

.clear-icon {
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  background: #ffffff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.sort-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6B7280;
  border-radius: 8rpx;
  transition: all 0.3s;
  margin-right: 16rpx;
}

.sort-item:last-child {
  margin-right: 0;
}

.sort-item.active {
  color: #87A878;
  font-weight: 600;
  background: rgba(135, 168, 120, 0.1);
}

.sort-arrow {
  margin-left: 4rpx;
  font-size: 24rpx;
}

/* 城市列表 */
.city-list {
  background: #ffffff;
  padding: 0 32rpx;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  transition: all 0.3s;
}

.city-item:last-child {
  border-bottom: none;
}

.city-item:active {
  background: #F7F8FA;
  margin: 0 -32rpx;
  padding: 32rpx;
}

/* 左侧信息 */
.city-item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.city-item-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.city-item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-right: 12rpx;
}

.city-item-location {
  font-size: 24rpx;
  color: #9CA3AF;
}

.city-item-tags {
  display: flex;
}

.city-tag {
  font-size: 22rpx;
  color: #87A878;
  background: rgba(135, 168, 120, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.city-tag.secondary {
  color: #6B7280;
  background: #F3F4F6;
}

/* 右侧评分 */
.city-item-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 24rpx;
  flex-shrink: 0;
}

.city-score {
  font-size: 40rpx;
  font-weight: 700;
  color: #87A878;
  margin-bottom: 8rpx;
}

.city-emoji {
  font-size: 32rpx;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
  color: #87A878;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #9CA3AF;
  font-size: 24rpx;
}
