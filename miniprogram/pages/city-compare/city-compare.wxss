/* pages/city-compare/city-compare.wxss */

/* 选择区域 */
.selection-section {
  margin-bottom: 30rpx;
}

/* 标签切换 */
.tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab.active {
  background: white;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.cities-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 20rpx 0;
}

.city-checkbox {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  transition: all 0.3s;
  position: relative;
}

.city-checkbox.selected {
  background: rgba(37, 99, 235, 0.1);
  border-color: #2563eb;
}

.checkbox-icon {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  margin-bottom: 12rpx;
  background: white;
  transition: all 0.3s;
}

.city-checkbox.selected .checkbox-icon {
  background: #2563eb;
  border-color: #2563eb;
}

.city-name {
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 500;
}

.city-province {
  font-size: 24rpx !important;
  color: #64748b !important;
  font-weight: normal !important;
  margin-top: 6rpx;
}

.selection-info {
  text-align: center;
  font-size: 28rpx;
  color: #0f172a;
  margin: 20rpx 0;
}

/* 结果区域 */
.result-section {
  margin-top: 30rpx;
}

/* 评分条形图 */
.score-bars {
  margin-top: 20rpx;
}

.score-bar-item {
  margin-bottom: 24rpx;
}

.city-name-small {
  font-size: 28rpx;
  font-weight: 500;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.bar-container {
  position: relative;
  height: 40rpx;
  background: #f1f5f9;
  border-radius: 20rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 20rpx;
  transition: width 0.5s ease;
  position: relative;
}

.bar-value {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  font-weight: bold;
  color: #0f172a;
  z-index: 1;
}

/* 对比表格 */
.compare-table {
  margin-top: 20rpx;
  width: 100%;
}

.table {
  display: table;
  width: 100%;
  min-width: 600rpx;
}

.table-row {
  display: table-row;
}

.table-row.header {
  background: #f8fafc;
  font-weight: bold;
}

.table-cell {
  display: table-cell;
  padding: 20rpx;
  font-size: 26rpx;
  border-bottom: 1rpx solid #e2e8f0;
  text-align: center;
  vertical-align: middle;
  min-width: 120rpx;
}

.table-cell.label {
  text-align: left;
  font-weight: 500;
  color: #64748b;
  background: #f8fafc;
  position: sticky;
  left: 0;
  z-index: 1;
}

.table-row:last-child .table-cell {
  border-bottom: none;
}
