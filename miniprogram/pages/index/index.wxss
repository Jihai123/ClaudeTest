/* ================================
   首页样式 - 简洁高效版
   核心目标：30秒内找到目标城市
   ================================ */

/* === 全局容器 === */
.container {
  background: #F7F8FA; /* 浅灰底色 */
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ================================
   1. 搜索 + 定位区（最高优先级）
   ================================ */

.search-section {
  background: #ffffff;
  padding: 32rpx 32rpx 24rpx;
  margin-bottom: 16rpx;
}

/* 搜索框 - 整行宽度，最突出 */
.search-box-main {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #E5E7EB;
}

.search-icon-main {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input-main {
  flex: 1;
  font-size: 30rpx;
  color: #1F2937;
}

.search-input-main::placeholder {
  color: #9CA3AF;
  font-size: 28rpx;
}

.clear-icon-main {
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 定位栏 */
.location-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #87A878 0%, #6B8E65 100%);
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(135, 168, 120, 0.2);
}

.location-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.location-arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ================================
   2. 快速入口区
   ================================ */

.quick-entry-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 24rpx;
}

.quick-entry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 32rpx 20rpx;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.entry-item:active {
  background: #E5E7EB;
  border-color: #87A878;
  transform: scale(0.95);
}

.entry-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.entry-label {
  font-size: 24rpx;
  color: #4B5563;
  text-align: center;
  line-height: 1.4;
}

/* ================================
   3. 最近访问 & 热门城市
   ================================ */

.recent-section,
.hot-section {
  background: #ffffff;
  padding: 32rpx 0;
  margin-bottom: 16rpx;
}

.recent-section .section-title,
.hot-section .section-title {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx 24rpx;
}

.section-more {
  font-size: 24rpx;
  color: #87A878;
}

.city-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.city-cards {
  display: inline-flex;
}

/* 城市卡片 - 小而清晰 */
.city-card-mini {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  margin-right: 20rpx;
  border: 2rpx solid #E5E7EB;
  transition: all 0.3s;
}

.city-card-mini:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  border-color: #87A878;
}

.city-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.city-card-score {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.score-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #87A878;
}

.score-unit {
  font-size: 20rpx;
  color: #6B7280;
  margin-left: 4rpx;
}

.city-card-tag {
  font-size: 22rpx;
  color: #87A878;
  background: rgba(135, 168, 120, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* ================================
   4. 榜单区（克制展示）
   ================================ */

.ranking-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.ranking-list {
  margin-top: 24rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-number {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6B7280;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ranking-number.top {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.ranking-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ranking-city {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 6rpx;
}

.ranking-province {
  font-size: 24rpx;
  color: #9CA3AF;
}

.ranking-score {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.ranking-score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #87A878;
  margin-right: 8rpx;
}

.ranking-emoji {
  font-size: 32rpx;
}

/* ================================
   5. 加载与空状态（简化版）
   ================================ */

.loading-simple {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

.empty-simple {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}
