/* pages/index/index.wxss */
.container {
  padding-bottom: 30rpx;
}

/* 搜索栏 */
.search-bar {
  background: #ffffff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
}

.search-icon {
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  margin-left: 15rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 20rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx;
}

.picker-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #0f172a;
}

.arrow {
  font-size: 20rpx;
  color: #64748b;
}

/* 城市列表 */
.cities-list {
  padding: 0 30rpx;
}

.city-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.city-card:active {
  transform: scale(0.98);
}

/* 城市头部 */
.city-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.city-info {
  flex: 1;
}

.city-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.city-province {
  font-size: 24rpx;
  color: #64748b;
}

.city-score {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  text-align: center;
  min-width: 100rpx;
}

.score-value {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.score-label {
  font-size: 20rpx;
  opacity: 0.9;
}

/* 城市维度 */
.city-dimensions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 20rpx 0;
}

.dimension-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: 8rpx;
}

.dimension-label {
  font-size: 24rpx;
  color: #64748b;
}

.dimension-value {
  font-size: 28rpx;
  font-weight: bold;
}

/* 城市底部 */
.city-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #e2e8f0;
}

.reviews-count {
  font-size: 24rpx;
  color: #64748b;
}

.rating {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.stars {
  color: #f59e0b;
  font-size: 24rpx;
}

.rating-value {
  font-size: 24rpx;
  color: #0f172a;
  font-weight: 500;
}

.no-rating {
  font-size: 24rpx;
  color: #64748b;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  margin-top: 40rpx;
  padding: 0 30rpx;
}

.page-btn {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 12rpx;
  border: none;
}

.page-btn[disabled] {
  background: #cbd5e1;
  color: #94a3b8;
}

.page-info {
  font-size: 28rpx;
  color: #64748b;
}
