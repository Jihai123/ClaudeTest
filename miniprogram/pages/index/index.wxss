/* ================================
   首页样式 - 现代极简设计
   风格：年轻化、现代感、视觉冲击
   ================================ */

/* 基础变量（通过 CSS 选择器实现） */
page {
  --primary-color: #6366F1;
  --primary-light: #818CF8;
  --primary-dark: #4F46E5;
  --success-color: #10B981;
  --warning-color: #F59E0B;
  --danger-color: #EF4444;
  --text-primary: #1F2937;
  --text-secondary: #6B7280;
  --text-tertiary: #9CA3AF;
  --bg-primary: #F9FAFB;
  --bg-card: #FFFFFF;
  --border-color: #E5E7EB;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
}

.page-container {
  background: var(--bg-primary);
  min-height: 100vh;
}

/* ================================
   渐变色背景类（10种配色）
   ================================ */

.gradient-bg-0 { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.gradient-bg-1 { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
.gradient-bg-2 { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
.gradient-bg-3 { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
.gradient-bg-4 { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }
.gradient-bg-5 { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); }
.gradient-bg-6 { background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); }
.gradient-bg-7 { background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); }
.gradient-bg-8 { background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%); }
.gradient-bg-9 { background: linear-gradient(135deg, #fddb92 0%, #d1fdff 100%); }

/* 占位符文字样式 */
.placeholder-text {
  font-size: 80rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ================================
   1. Hero 区域 - 视觉冲击
   ================================ */

.hero-section {
  position: relative;
  padding: 80rpx 32rpx 48rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  z-index: 0;
}

.hero-bg::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  animation: pulse 4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.1); opacity: 0.8; }
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}

/* 搜索框 */
.search-container {
  padding: 0 16rpx;
  margin-bottom: 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-xl);
  padding: 24rpx 32rpx;
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(10px);
}

.search-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-tertiary);
}

.clear-icon {
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 快捷标签 */
.quick-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding: 0 16rpx;
}

.quick-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  transition: all 0.3s ease;
}

.quick-tag:active,
.quick-tag.active {
  background: rgba(255, 255, 255, 0.95);
  transform: scale(0.95);
}

.quick-tag.active .tag-text {
  color: var(--primary-color);
}

.tag-icon {
  font-size: 28rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.quick-tag.active .tag-text,
.quick-tag:active .tag-text {
  color: var(--primary-color);
}

/* ================================
   2. 轮播区域
   ================================ */

.carousel-section {
  padding: 32rpx 0;
  background: var(--bg-card);
  margin-top: -20rpx;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  position: relative;
  z-index: 2;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon {
  font-size: 36rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.city-carousel {
  height: 420rpx;
  padding: 0 12rpx;
}

.carousel-card {
  position: relative;
  height: 400rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 0 8rpx;
  box-shadow: var(--shadow-md);
}

.carousel-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.carousel-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 0;
}

.carousel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    transparent 0%,
    transparent 40%,
    rgba(0, 0, 0, 0.7) 100%
  );
}

.carousel-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  color: #ffffff;
}

.carousel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.carousel-city {
  font-size: 40rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.carousel-score {
  display: flex;
  align-items: baseline;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: var(--radius-md);
  padding: 8rpx 16rpx;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFD700;
}

.score-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 4rpx;
}

.carousel-province {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
  display: block;
}

.carousel-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.carousel-tag {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5px);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.carousel-rent {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 500;
}

/* ================================
   3. 预算区域
   ================================ */

.budget-section {
  padding: 32rpx 32rpx;
  background: var(--bg-card);
  margin-top: 16rpx;
}

.budget-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.budget-card {
  padding: 24rpx;
  border-radius: var(--radius-lg);
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease;
}

.budget-card:active {
  transform: scale(0.98);
}

.budget-card-0 {
  background: linear-gradient(135deg, #10B981 0%, #34D399 100%);
}

.budget-card-1 {
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
}

.budget-card-2 {
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
}

.budget-card-3 {
  background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
}

.budget-label {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.budget-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.budget-count {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ================================
   4. 榜单区域
   ================================ */

.ranking-section {
  padding: 32rpx;
  background: var(--bg-card);
  margin-top: 16rpx;
}

.ranking-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
}

.ranking-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 16rpx;
  border-radius: var(--radius-md);
  transition: all 0.3s ease;
}

.ranking-tab.active {
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.tab-icon {
  font-size: 28rpx;
}

.tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.ranking-tab.active .tab-text {
  color: var(--primary-color);
  font-weight: 600;
}

.ranking-list {
  min-height: 200rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: background 0.2s ease;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-item:active {
  background: var(--bg-primary);
}

.ranking-medal {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-primary);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ranking-medal.top-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.4);
}

.ranking-medal.top-2 {
  background: linear-gradient(135deg, #C0C0C0 0%, #E8E8E8 100%);
  box-shadow: 0 4rpx 12rpx rgba(192, 192, 192, 0.4);
}

.ranking-medal.top-3 {
  background: linear-gradient(135deg, #CD7F32 0%, #DDA15E 100%);
  box-shadow: 0 4rpx 12rpx rgba(205, 127, 50, 0.4);
}

.medal-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.ranking-medal.top-1 .medal-text,
.ranking-medal.top-2 .medal-text,
.ranking-medal.top-3 .medal-text {
  color: #ffffff;
}

.ranking-avatar {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  margin-right: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ranking-avatar-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ranking-info {
  flex: 1;
  min-width: 0;
}

.ranking-city {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.ranking-province {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ranking-score-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.ranking-score {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.ranking-emoji {
  font-size: 28rpx;
}

.ranking-empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* ================================
   5. 热门城市网格
   ================================ */

.hot-section {
  padding: 32rpx;
  background: var(--bg-card);
  margin-top: 16rpx;
}

.hot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.hot-card {
  position: relative;
  height: 280rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s ease;
}

.hot-card:active {
  transform: scale(0.98);
}

.hot-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.hot-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 0;
}

.hot-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    transparent 0%,
    transparent 30%,
    rgba(0, 0, 0, 0.7) 100%
  );
}

.hot-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
  color: #ffffff;
}

.hot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.hot-city {
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.hot-score {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5px);
  border-radius: var(--radius-sm);
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFD700;
}

.hot-province {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
  display: block;
}

.hot-tags {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hot-tag {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #ffffff;
}

.hot-rent {
  font-size: 22rpx;
  color: #10B981;
  font-weight: 500;
}

/* ================================
   6. 最近浏览
   ================================ */

.recent-section {
  padding: 32rpx 0;
  background: var(--bg-card);
  margin-top: 16rpx;
}

.recent-section .section-header {
  padding: 0 32rpx 24rpx;
}

.recent-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.recent-cards {
  display: inline-flex;
  gap: 16rpx;
}

.recent-card {
  width: 160rpx;
  display: inline-flex;
  flex-direction: column;
  transition: transform 0.3s ease;
}

.recent-card:active {
  transform: scale(0.95);
}

.recent-image {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recent-image-inner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recent-placeholder-text {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

.recent-info {
  text-align: center;
}

.recent-city {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.recent-score {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ================================
   7. 加载状态
   ================================ */

.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  z-index: 999;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ================================
   8. 底部安全区
   ================================ */

.safe-bottom {
  height: 40rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ================================
   9. 动画效果
   ================================ */

/* 淡入动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.carousel-section,
.budget-section,
.ranking-section,
.hot-section,
.recent-section {
  animation: fadeIn 0.5s ease-out;
}

/* 点击反馈 */
.quick-tag:active,
.budget-card:active,
.ranking-item:active,
.hot-card:active,
.recent-card:active {
  opacity: 0.85;
}
