<!--pages/index/index.wxml-->
<view class="container">
  <!-- 1. 搜索 + 定位区（最高优先级） -->
  <view class="search-section">
    <!-- 搜索框 -->
    <view class="search-box-main">
      <icon class="search-icon-main" type="search" size="20" color="#87A878" />
      <input
        class="search-input-main"
        placeholder="输入城市名 / 拼音 / 首字母"
        value="{{searchQuery}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
      <icon wx:if="{{searchQuery}}" class="clear-icon-main" type="clear" size="18" color="#999" bindtap="onClearSearch" />
    </view>

    <!-- 定位 -->
    <view class="location-bar" bindtap="onLocationTap">
      <text class="location-icon">📍</text>
      <text class="location-text">{{currentLocation || '定位中...'}}</text>
      <text class="location-arrow">→</text>
    </view>
  </view>

  <!-- 2. 快速入口区（条件找城） -->
  <view class="quick-entry-section">
    <view class="section-title">快速找城</view>
    <view class="quick-entry-grid">
      <view class="entry-item" bindtap="onQuickEntry" data-type="recommend">
        <text class="entry-icon">🧭</text>
        <text class="entry-label">我适合住哪</text>
      </view>
      <view class="entry-item" bindtap="onQuickEntry" data-type="lowCost">
        <text class="entry-icon">💰</text>
        <text class="entry-label">低生活成本</text>
      </view>
      <view class="entry-item" bindtap="onQuickEntry" data-type="elderly">
        <text class="entry-icon">👵</text>
        <text class="entry-label">适合养老</text>
      </view>
      <view class="entry-item" bindtap="onQuickEntry" data-type="employment">
        <text class="entry-icon">💼</text>
        <text class="entry-label">就业机会多</text>
      </view>
      <view class="entry-item" bindtap="onQuickEntry" data-type="airQuality">
        <text class="entry-icon">🌿</text>
        <text class="entry-label">空气好</text>
      </view>
      <view class="entry-item" bindtap="onQuickEntry" data-type="coastal">
        <text class="entry-icon">🌊</text>
        <text class="entry-label">沿海城市</text>
      </view>
    </view>
  </view>

  <!-- 3. 最近访问（如果有） -->
  <view class="recent-section" wx:if="{{recentCities.length > 0}}">
    <view class="section-title">最近访问</view>
    <scroll-view scroll-x class="city-scroll">
      <view class="city-cards">
        <view
          wx:for="{{recentCities}}"
          wx:key="id"
          class="city-card-mini"
          bindtap="onCityTap"
          data-id="{{item.id}}"
        >
          <text class="city-card-name">{{item.name}}</text>
          <view class="city-card-score">
            <text class="score-number">{{item.overall_score || 0}}</text>
            <text class="score-unit">分</text>
          </view>
          <text class="city-card-tag">{{item.mainTag}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 4. 热门城市 -->
  <view class="hot-section">
    <view class="section-header">
      <text class="section-title">热门城市</text>
      <text class="section-more" bindtap="onViewMore" data-type="hot">查看更多 →</text>
    </view>
    <scroll-view scroll-x class="city-scroll">
      <view class="city-cards">
        <view
          wx:for="{{hotCities}}"
          wx:key="id"
          class="city-card-mini"
          bindtap="onCityTap"
          data-id="{{item.id}}"
        >
          <text class="city-card-name">{{item.name}}</text>
          <view class="city-card-score">
            <text class="score-number">{{item.overall_score || 0}}</text>
            <text class="score-unit">分</text>
          </view>
          <text class="city-card-tag">{{item.mainTag}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 5. 榜单与推荐区（克制展示） -->
  <view class="ranking-section">
    <view class="section-header">
      <text class="section-title">本月宜居榜单</text>
      <text class="section-more" bindtap="onViewMore" data-type="ranking">查看完整榜单 →</text>
    </view>
    <view class="ranking-list">
      <view
        wx:for="{{rankingCities}}"
        wx:key="id"
        class="ranking-item"
        bindtap="onCityTap"
        data-id="{{item.id}}"
      >
        <view class="ranking-number {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
        <view class="ranking-info">
          <text class="ranking-city">{{item.name}}</text>
          <text class="ranking-province">{{item.province}}</text>
        </view>
        <view class="ranking-score">
          <text class="ranking-score-value">{{item.overall_score || 0}}</text>
          <text class="ranking-emoji">{{item.emoji}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-simple">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && hotCities.length === 0}}" class="empty-simple">
    <text class="empty-icon">🏙️</text>
    <text class="empty-text">暂无城市数据</text>
  </view>
</view>
