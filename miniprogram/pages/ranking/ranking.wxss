/* pages/ranking/ranking.wxss */

/* 容器 */
.container {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #87A878 0%, #6B8E65 100%);
  padding: 60rpx 32rpx 40rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #ffffff;
  padding: 16rpx 32rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  border-radius: 12rpx;
  transition: all 0.3s;
  margin-right: 12rpx;
}

.tab-item:last-child {
  margin-right: 0;
}

.tab-item.active {
  background: linear-gradient(135deg, #87A878 0%, #6B8E65 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(135, 168, 120, 0.3);
}

/* 榜单列表 */
.ranking-list {
  background: #ffffff;
  padding: 0 32rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  transition: all 0.3s;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-item.top-three {
  background: linear-gradient(90deg, rgba(255, 215, 0, 0.05) 0%, transparent 100%);
  margin: 0 -32rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.ranking-item:active {
  background: #F7F8FA;
}

/* 排名徽章 */
.ranking-badge {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
}

.ranking-badge.gold {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 215, 0, 0.4);
}

.ranking-badge.silver {
  background: linear-gradient(135deg, #C0C0C0 0%, #A8A8A8 100%);
  box-shadow: 0 6rpx 20rpx rgba(192, 192, 192, 0.4);
}

.ranking-badge.bronze {
  background: linear-gradient(135deg, #CD7F32 0%, #B8722B 100%);
  box-shadow: 0 6rpx 20rpx rgba(205, 127, 50, 0.4);
}

.ranking-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #6B7280;
}

.ranking-badge.gold .ranking-number,
.ranking-badge.silver .ranking-number,
.ranking-badge.bronze .ranking-number {
  color: #ffffff;
}

.ranking-medal {
  font-size: 28rpx;
  margin-top: 4rpx;
}

/* 城市信息 */
.ranking-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.city-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.city-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
  margin-right: 12rpx;
}

.city-location {
  font-size: 24rpx;
  color: #9CA3AF;
}

.city-tags {
  display: flex;
}

.city-tag {
  font-size: 22rpx;
  color: #87A878;
  background: rgba(135, 168, 120, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.city-tag.secondary {
  color: #6B7280;
  background: #F3F4F6;
}

/* 评分 */
.ranking-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 24rpx;
  flex-shrink: 0;
}

.score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #87A878;
  margin-bottom: 4rpx;
}

.score-label {
  font-size: 20rpx;
  color: #9CA3AF;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 底部说明 */
.ranking-footer {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
}
