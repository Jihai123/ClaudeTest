# 服务器配置
PORT=3000
NODE_ENV=development
# BASE_PATH 配置说明:
# - 如果前端访问路径是 https://example.com/livablecities/，则设置为 /livablecities
# - 如果前端访问路径是 https://example.com/，则留空或不设置
# - 前端会自动检测路径并适配，后端需要与前端路径一致
#BASE_PATH=/livablecities

# SEO配置
# 网站基础URL - 用于生成Sitemap和SEO标签
BASE_URL=https://tangping.com

# JWT配置
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# 数据库配置
DB_PATH=./database.sqlite

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# 跨域配置
CORS_ORIGIN=*

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 图片上传配置
# 上传方式: local | imgbb | r2 | oss
IMAGE_UPLOAD_METHOD=local

# ImgBB配置 (免费图床，需要注册获取API key: https://api.imgbb.com/)
#IMGBB_API_KEY=your_imgbb_api_key

# Cloudflare R2配置
#R2_ACCOUNT_ID=your_account_id
#R2_ACCESS_KEY_ID=your_access_key
#R2_SECRET_ACCESS_KEY=your_secret_key
#R2_BUCKET_NAME=your_bucket_name
#R2_PUBLIC_DOMAIN=your.custom.domain.com

# 阿里云OSS配置
#OSS_REGION=oss-cn-hangzhou
#OSS_ACCESS_KEY_ID=your_access_key_id
#OSS_ACCESS_KEY_SECRET=your_access_key_secret
#OSS_BUCKET=your_bucket_name

# GPT/Plugin 受限接口（默认关闭；生产须由 Codex 现场生成随机密钥）
# 仅填入 API 密钥的 SHA-256 十六进制摘要，不填原始密钥：
# YIJU_AGENT_API_KEY_SHA256=<SHA256_OF_RANDOM_API_KEY>
# GPT 低风险文字字段自动生效，默认关闭；通过真实来源端到端验收后再开启
YIJU_AGENT_AUTO_APPLY=false
YIJU_AGENT_AUTO_APPLY_DAILY_LIMIT=10
